  <!-- PAGE 3: 共享黑板架构与共识决议 -->
  <diagram id="diag_blackboard" name="3. 共享黑板架构与共识决议机制">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bb_writer" value="垂直专家完成推演&#xa;[类: BaseAgentPod] execute()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bb_pack" value="封装 BlackboardNote 数据包&#xa;author, role, content, timestamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bb_lock" value="获取异步互斥写锁&#xa;async with asyncio.Lock()" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bb_write" value="写入活跃会话主题 MessageLog&#xa;版本号自增 version++" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="320" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bb_conflict" value="是否存在目标对立与资源冲突?&#xa;(例如: 制作预算 vs 高规格特效)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="410" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bb_arbitrate" value="[9号总控议长] resolve_conflict()&#xa;基于短剧投放阶段 ROI 仲裁裁决" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="425" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bb_consensus" value="写入 ConsensusTree 达成一致决策&#xa;更新阶段里程碑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="540" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bb_notify" value="广播 WebSocket 事件&#xa;实时更新前端座席气泡与进度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="460" y="630" width="220" height="50" as="geometry" />
        </mxCell>
        <!-- 连线 -->
        <mxCell id="e_bb1" edge="1" parent="1" source="bb_writer" target="bb_pack"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_bb2" edge="1" parent="1" source="bb_pack" target="bb_lock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_bb3" value="持有写锁" edge="1" parent="1" source="bb_lock" target="bb_write"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_bb4" edge="1" parent="1" source="bb_write" target="bb_conflict"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_bb5" value="有冲突" edge="1" parent="1" source="bb_conflict" target="bb_arbitrate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_bb6" edge="1" parent="1" source="bb_arbitrate" target="bb_consensus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_bb7" value="无冲突" edge="1" parent="1" source="bb_conflict" target="bb_consensus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_bb8" edge="1" parent="1" source="bb_consensus" target="bb_notify"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
