        <mxCell id="node_wf_single" value="[类: SpecializedPod] run_step()&#xa;单专家垂直响应并交付" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="780" y="145" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_planner" value="[类: MasterOrchestratorPod]&#xa;dynamic_llm_planner() 动态立项拆解&#xa;输出 Markdown 待办 (- [ ] Step N)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="260" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_subject" value="确立统一研讨标的 (mission_subject)&#xa;《高冷千金的贴身高手》工业化协同研发" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="360" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_ui_render" value="[前端看板] AgentRoundTableCanvas.vue&#xa;渲染 TodoList: pending 状态 / 进度条 0%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="450" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_loop_cond" value="当前步骤 step_idx &lt; steps.length ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="445" y="540" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_step_in_progress" value="动态切换清单状态: status = 'in_progress'&#xa;前端触发微光脉冲 Spinner 动画" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="440" y="660" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_wrap_prompt" value="专精上下文封装 ContextWrapper&#xa;注入【研讨标的】与【专精任务指令】&#xa;剔除流程杂质，严防专家离题" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="440" y="750" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_expert_exec" value="垂直专家 Pod 推演执行&#xa;[agent_1 ~ agent_8] 大模型专精推演" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="850" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_write_bb" value="写入公共黑板共享内存&#xa;[类: BlackboardMemoryHub] write_note()&#xa;记录方案观点、角色标签与单步耗时" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="440" y="940" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_step_done" value="更新清单状态: status = 'completed'&#xa;打标 elapsedCost = 'XX.Xs' / 步进 step_idx++" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="1050" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_summary" value="[类: MasterOrchestratorPod] run_summary()&#xa;9号主控常务议长终审总结&#xa;输出: 1.专家摘要 2.综合决议 3.行动纲领" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="550" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_export" value="生成并导出交付工件 (Artifact)&#xa;生成多模态研讨白皮书 Markdown / JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
