  <!-- PAGE 1: 智能体 Workflow 待办流转框架 -->
  <diagram id="diag_workflow" name="1. 智能体 Workflow 执行与状态流转">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- 节点定义 -->
        <mxCell id="node_wf_start" value="制片人指令输入 (User Prompt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="node_wf_check" value="是否为多智能体复合任务?&#xa;(包含'至少5个智能体'/'圆桌立项')" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="130" width="240" height="90" as="geometry" />
