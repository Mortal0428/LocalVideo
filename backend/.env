# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Cyx.chen27
MYSQL_DATABASE=video_platform_db

# Dual-mode support (False now because MySQL is connected)
USE_SQLITE_FALLBACK=False

# Storage Configuration (Local buffer / Cloud Storage)
UPLOAD_DIR=storage/uploads
PROCESSED_VIDEO_DIR=storage/hls

# Cloud Storage (S3 / OSS compatible)
STORAGE_TYPE=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Local Ollama & LLM
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=deepseek-r1:1.5b
DEFAULT_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Xiaomi MiMo Cloud API
MIMO_BASE_URL=https://api.xiaomimimo.com/v1


# =========================================================================
# LangSmith Observability & Tracing Configuration
# =========================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=Personal

# =========================================================================
# Coze OpenAPI 凭证与端点配置
