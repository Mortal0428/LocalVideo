# =========================================================================
# CinemaAgent 全栈容器化生产环境配置模板
# 运维同事请将其重命名为 .env 并按需填写真实的密码与密钥
# =========================================================================

# MySQL 凭据
MYSQL_ROOT_PASSWORD=Cyx.chen27
MYSQL_DATABASE=video_platform_db

# OpenList 网关管理员配置 (默认与 data 目录一致)
OPENLIST_USERNAME=admin
OPENLIST_PASSWORD=123456

# =========================================================================
# 大模型引擎配置 (二选一即可)
# =========================================================================

# 模式 1：本地 Ollama 引擎 (默认启用，容器内私有化部署，无需联网调用外部 API)
ACTIVE_PROVIDER=ollama
OLLAMA_BASE_URL=http://cinema-ollama:11434
DEFAULT_LLM_MODEL=deepseek-r1:1.5b
DEFAULT_EMBEDDING_MODEL=qwen3-embedding:0.6b

# 模式 2：云端商用大模型 API (若服务器无显卡且追求高并发，可改设 ACTIVE_PROVIDER=mimo)
# ACTIVE_PROVIDER=mimo
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=your_production_mimo_api_key_here

# Coze 开放生态智能体配置 (10号智能体)
COZE_API_TOKEN=your_production_coze_token_here
COZE_BOT_ID=7700811095929323554
